# Neo4j Configuration
# Porta 7699 (Bolt) e 7475 (Browser) — evita conflito com Neo4j já instalado na máquina
# Se você preferir usar um Neo4j existente, aponte para a porta/credenciais dele
NEO4J_URI=bolt://localhost:7699
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_VECTOR_THRESHOLD=0.9

# Embedding Model (rodado localmente via HuggingFace — não precisa de API key)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# OpenRouter Configuration — modelos free disponíveis em https://openrouter.ai/
NLP_MODEL=openrouter/auto
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Neo4j Embeddings
