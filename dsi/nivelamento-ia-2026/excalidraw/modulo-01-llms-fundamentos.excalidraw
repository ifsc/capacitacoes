      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1020967342,
      "updated": 1783603302372,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 35,
      "index": "b0W",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "❌ Tarefas que um Algoritmo Determinístico Resolve Melhor",
