    {
      "id": "m1507456aa17f4db5",
      "type": "text",
      "x": 1158.0234375,
      "y": 1579.99609375,
      "width": 519.68,
      "height": 21.6,
      "text": "❌ Tarefas que um Algoritmo Determinístico Resolve Melhor",
      "fontSize": 16,
      "strokeColor": "#e03131",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
