    {
      "id": "pa791d8466af447dd",
      "type": "text",
      "x": 834,
      "y": 12564.8,
      "width": 668,
      "height": 157.5,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": "p7a0d38f00840493e",
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1818967474,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "A LLM desconhece o histórico do sistema. Só quem mantém o\nprojeto verifica se:\n—  a regra corresponde ao processo real da instituição\n—  a decisão é sustentável para a equipe\n—  o código respeita o padrão interno adotado",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "b3j",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "A LLM desconhece o histórico do sistema. Só quem mantém o\nprojeto verifica se:\n—  a regra corresponde ao processo real da instituição\n—  a decisão é sustentável para a equipe\n—  o código respeita o padrão interno adotado"
    },
