      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1975180530,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "Propriedades numeradas que viram teste\nbaseado em propriedade, cada uma\ndeclarando qual requisito valida.\n\nÉ o elo entre o critério de aceite e o\nteste que o verifica.",
      "fontSize": 19,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
