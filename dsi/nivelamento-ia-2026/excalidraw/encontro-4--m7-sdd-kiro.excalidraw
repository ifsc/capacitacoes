    },
    {
      "id": "pe6419efb3b984b64",
      "type": "text",
      "x": 98,
      "y": 2364.8,
      "width": 668,
      "height": 220.5,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": "p5781630c689842dd",
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 964041202,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "Documento impecável no primeiro dia. O código nasce dele.\n\nAí o código evolui com pressa, a especificação fica para trás\ne vira documentação que parece verdadeira e não é.\n\nFalsa confiança é pior que ausência de documento: leva a\ndecisão errada com convicção.",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "ap",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "Documento impecável no primeiro dia. O código nasce dele.\n\nAí o código evolui com pressa, a especificação fica para trás\ne vira documentação que parece verdadeira e não é.\n\nFalsa confiança é pior que ausência de documento: leva a\ndecisão errada com convicção."
    },
