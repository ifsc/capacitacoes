    },
    {
      "id": "p90983de17ac241c7",
      "type": "text",
      "x": 324.25,
      "y": 645.29,
      "width": 1177.75,
      "height": 94.5,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": "p775e6c480a6c44c3",
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 610166190,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "Revisar cinco tarefas mal escritas custa dez minutos. Revisar quinhentas linhas geradas a partir dessas\ncinco tarefas custa um dia.\nO método não é sobre escrever mais: é sobre mover a revisão para onde ela ainda é barata.",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "aG",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "Revisar cinco tarefas mal escritas custa dez minutos. Revisar quinhentas linhas geradas a partir dessas\ncinco tarefas custa um dia.\nO método não é sobre escrever mais: é sobre mover a revisão para onde ela ainda é barata."
    },
