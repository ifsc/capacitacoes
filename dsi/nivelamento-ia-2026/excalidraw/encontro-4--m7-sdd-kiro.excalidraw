    },
    {
      "id": "p6ea734e6c3c949e0",
      "type": "text",
      "x": 283,
      "y": 2708.82,
      "width": 1219,
      "height": 94.5,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": "p5781630c689842dd",
