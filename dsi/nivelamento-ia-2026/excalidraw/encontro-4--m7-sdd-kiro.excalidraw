      "text": "O    C R I T É R I O    D E    C O R T E",
      "fontSize": 15,
      "strokeColor": "#1d4ed8",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.2,
