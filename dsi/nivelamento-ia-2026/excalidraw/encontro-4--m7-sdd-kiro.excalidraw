      "locked": false,
      "seed": 1,
      "versionNonce": 1934213682,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "—  Documento em processador de texto ou wiki que ninguém abre\n—  Escrita só para humanos lerem\n—  Desatualizada na primeira semana de código\n—  «A verdade está no código», ou seja, em lugar nenhum",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "aX",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "—  Documento em processador de texto ou wiki que ninguém abre\n—  Escrita só para humanos lerem\n—  Desatualizada na primeira semana de código\n—  «A verdade está no código», ou seja, em lugar nenhum"
    },
