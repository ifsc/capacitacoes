      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1487624562,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "O que o sistema faz e como ele é construído:\n\n—  regra de negócio e comportamento observável\n—  contrato de entrada e saída\n—  decisão de arquitetura, com o motivo\n—  critério de aceite verificável",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "b1R",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "O que o sistema faz e como ele é construído:\n\n—  regra de negócio e comportamento observável\n—  contrato de entrada e saída\n—  decisão de arquitetura, com o motivo\n—  critério de aceite verificável"
    },
