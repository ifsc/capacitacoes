    {
      "id": "p22063087c86d4bd9",
      "type": "text",
      "x": 481,
      "y": 6699.52,
      "width": 1021,
      "height": 126,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
