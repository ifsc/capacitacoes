    },
    {
      "id": "p7a128a2f59f541b6",
      "type": "text",
      "x": 98,
      "y": 6444.8,
      "width": 668,
      "height": 189,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
