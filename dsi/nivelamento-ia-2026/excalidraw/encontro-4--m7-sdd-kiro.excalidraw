    {
      "id": "p39575d2a3d914c57",
      "type": "text",
      "x": 834,
      "y": 6444.8,
      "width": 668,
      "height": 189,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": "p451d2a9bb77549eb",
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 498410738,
      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "Como o agente trabalha, independentemente da funcionalidade:\n\n—  quais MCPs existem e o que cada um pode fazer\n—  como subir e recriar o ambiente para conferir uma mudança\n—  o que não pode ser alterado, como migração já aplicada\n—  convenção de código do repositório",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "b1V",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "Como o agente trabalha, independentemente da funcionalidade:\n\n—  quais MCPs existem e o que cada um pode fazer\n—  como subir e recriar o ambiente para conferir uma mudança\n—  o que não pode ser alterado, como migração já aplicada\n—  convenção de código do repositório"
    },
