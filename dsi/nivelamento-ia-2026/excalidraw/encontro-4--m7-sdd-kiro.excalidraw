    {
      "id": "p28a1b235a56b496a",
      "type": "text",
      "x": 588.67,
      "y": 9476.8,
      "width": 422.67,
      "height": 171,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
