      "updated": 1788384681826,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "Especificação ancorada",
      "fontSize": 24,
      "strokeColor": "#0f172a",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.2,
      "backgroundColor": "transparent",
