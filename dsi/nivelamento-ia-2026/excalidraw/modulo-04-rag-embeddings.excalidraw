      "x": 1128,
      "y": 1650,
      "width": 420,
      "height": 146.25,
      "text": "researcher = Agent(\n  role=\"Busca Edital e Prazos\",\n  tools=[search_edital]\n)\nvalidator = Agent(\n  role=\"Valida Datas e Fontes\"\n)\ntask = Task(\n  description=\"Verifique docs da\n    2ª chamada. Confirme datas\",\n  agents=[researcher, validator]\n)\nCrew(tasks=[task]).kickoff()",
