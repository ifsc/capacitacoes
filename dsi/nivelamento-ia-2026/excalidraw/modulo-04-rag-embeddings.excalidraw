    {
      "id": "m6bcfe57f5f0344e5",
      "type": "text",
      "x": 60,
      "y": 1610,
      "width": 400,
      "height": 420,
      "text": "1. Prompt bem estruturado > modelo caro\n2. 5 elementos: role, contexto,\n   restrições, formato, exemplos\n3. RTF para tarefas simples\n   CARE para objetivos de negócio\n   RISE para múltiplos passos\n4. Few-shot = exemplos concretos\n   no contexto — funciona igual chunks\n5. Chain of Thought força raciocínio\n   antes de responder — reduz alucinação\n6. Antipadrões: vagueza, sobrecarga,\n   contradição, confiança cega",
      "fontSize": 17,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1488233977,
      "updated": 1783712857329,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 35,
      "index": "b0L",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "1. Prompt bem estruturado > modelo caro\n2. 5 elementos: role, contexto,\n   restrições, formato, exemplos\n3. RTF para tarefas simples\n   CARE para objetivos de negócio\n   RISE para múltiplos passos\n4. Few-shot = exemplos concretos\n   no contexto — funciona igual chunks\n5. Chain of Thought força raciocínio\n   antes de responder — reduz alucinação\n6. Antipadrões: vagueza, sobrecarga,\n   contradição, confiança cega",
      "customData": {
        "name": "m6bcfe57f5f0344e5"
      }
    },
