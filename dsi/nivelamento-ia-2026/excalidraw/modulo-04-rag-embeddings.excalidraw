    {
      "id": "mf6a495038a93417d",
      "type": "text",
      "x": 1160,
      "y": 340,
      "width": 652.460693359375,
      "height": 75.38122106481481,
      "text": "• Chunk mal dimensionado (muito grande → perde precisão; muito pequeno → perde contexto)\n• Embedding de baixa qualidade (modelo errado para o domínio) - ex juridiquez do brasil\n• Threshold de similaridade errado (chunks irrelevantes sendo injetados) - fitro configurado errado\n• Injeção incompleta: ex manutenção a cada 10000km ",
      "fontSize": 15.076244212962962,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1307986884,
      "updated": 1787086641713,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 152,
      "index": "ab",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "• Chunk mal dimensionado (muito grande → perde precisão; muito pequeno → perde contexto)\n• Embedding de baixa qualidade (modelo errado para o domínio) - ex juridiquez do brasil\n• Threshold de similaridade errado (chunks irrelevantes sendo injetados) - fitro configurado errado\n• Injeção incompleta: ex manutenção a cada 10000km ",
      "customData": {
        "name": "mf6a495038a93417d"
      }
    },
