    {
      "id": "m1d5531ea519644ef",
      "type": "text",
      "x": 532.05859375,
      "y": 163.39609375,
      "width": 376.89453125,
      "height": 350,
      "text": "Fluxo:\n  Pergunta → Busca docs relevantes\n          → LLM (contexto enxuto)\n          → Resposta baseada em fontes\n\n✅ Vantagens:\n• Respostas baseadas em dados reais\n• Fontes citáveis e auditáveis\n• Atualização fácil (reindexa, não retreina)\n• Sem GPU, sem dados rotulados, sem fine-tuning\n\nAnalogia:\nAluno com livro aberto na página certa —\nconsulta a fonte e responde com precisão.",
      "fontSize": 20,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 286349655,
      "updated": 1783706948429,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 32,
      "index": "a8",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "Fluxo:\n  Pergunta → Busca docs relevantes\n          → LLM (contexto enxuto)\n          → Resposta baseada em fontes\n\n✅ Vantagens:\n• Respostas baseadas em dados reais\n• Fontes citáveis e auditáveis\n• Atualização fácil (reindexa, não retreina)\n• Sem GPU, sem dados rotulados, sem fine-tuning\n\nAnalogia:\nAluno com livro aberto na página certa —\nconsulta a fonte e responde com precisão.",
      "customData": {
        "name": "m1d5531ea519644ef"
      }
