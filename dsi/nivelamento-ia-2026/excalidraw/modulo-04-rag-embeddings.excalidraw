    {
      "id": "me4634f1436ee4569",
      "type": "text",
      "x": 60.99609375,
      "y": 166,
      "width": 360.546875,
      "height": 350,
      "text": "Fluxo mais comum na prática:\n  Pergunta + doc inteiro no prompt\n  → LLM (contexto poluído)\n  → Resposta degradada ou cara\n\nOu então:\n  Pergunta → LLM (só memória)\n  → Resposta sem fonte\n\n⚠️ Problemas:\n• Alucina — sem fonte externa\n• Informação desatualizada\n• Não conhece dados do seu domínio\n• Caro e degrada com contexto cheio",
      "fontSize": 20,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 759176537,
      "updated": 1783706942998,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 44,
      "index": "a5",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "Fluxo mais comum na prática:\n  Pergunta + doc inteiro no prompt\n  → LLM (contexto poluído)\n  → Resposta degradada ou cara\n\nOu então:\n  Pergunta → LLM (só memória)\n  → Resposta sem fonte\n\n⚠️ Problemas:\n• Alucina — sem fonte externa\n• Informação desatualizada\n• Não conhece dados do seu domínio\n• Caro e degrada com contexto cheio",
      "customData": {
        "name": "me4634f1436ee4569"
      }
    },
