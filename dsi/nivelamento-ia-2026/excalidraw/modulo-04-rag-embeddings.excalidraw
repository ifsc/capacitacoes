    {
      "id": "m93a177a076634efb",
      "type": "text",
      "x": 530,
      "y": 1610,
      "width": 304.21533203125,
      "height": 255,
      "text": "1. RAG recupera só o trecho relevante\n   — não o documento inteiro\n2. Chunk = unidade de contexto\n   tamanho e overlap definem qualidade\n3. Embedding = coordenada no espaço\n   semântico — modelo ruim, busca ruim\n4. topK controla quantos chunks entram\n   — mais nem sempre é melhor\n5. RAG tradicional: docs lineares\n   Graph RAG: dados com relações\n7. Progressive disclosure: carregue\n   só o necessário, quando necessário",
      "fontSize": 17,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 1296710489,
      "updated": 1787320899925,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 39,
      "index": "b0O",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "1. RAG recupera só o trecho relevante\n   — não o documento inteiro\n2. Chunk = unidade de contexto\n   tamanho e overlap definem qualidade\n3. Embedding = coordenada no espaço\n   semântico — modelo ruim, busca ruim\n4. topK controla quantos chunks entram\n   — mais nem sempre é melhor\n5. RAG tradicional: docs lineares\n   Graph RAG: dados com relações\n7. Progressive disclosure: carregue\n   só o necessário, quando necessário",
      "customData": {
        "name": "m93a177a076634efb"
      }
    },
