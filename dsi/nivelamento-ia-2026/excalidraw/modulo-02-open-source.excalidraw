      "y": 135,
      "width": 135.72,
      "height": 24.3,
      "text": "🍳 Open-Source",
      "fontSize": 18,
      "strokeColor": "#2f9e44",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
