    {
      "id": "m84dafa0a2511402b",
      "type": "text",
      "x": 60,
      "y": 1190,
      "width": 356.580078125,
      "height": 180,
      "text": "SLM Local (latência mínima, custo zero):\n  • Sumarização de logs e documentos   \n  • Classificação de tickets e e-mails\n  • Parsing de dados estruturados        \n  • Autocomplete e sugestões simples\n  • Extração de entidades\n\nLLM Cloud (raciocínio complexo, pontual):\n  • Design de arquitetura de software    • Debugging multi-arquivo\n  • Geração de documentação técnica     • Análise de\nvulnerabilidades\n  • Tradução e refatoração complexa",
      "fontSize": 12,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": false,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 2103176384,
      "updated": 1786126768169,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 32,
      "index": "ab",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "SLM Local (latência mínima, custo zero):\n  • Sumarização de logs e documentos   \n  • Classificação de tickets e e-mails\n  • Parsing de dados estruturados        \n  • Autocomplete e sugestões simples\n  • Extração de entidades\n\nLLM Cloud (raciocínio complexo, pontual):\n  • Design de arquitetura de software    • Debugging multi-arquivo\n  • Geração de documentação técnica     • Análise de vulnerabilidades\n  • Tradução e refatoração complexa",
      "customData": {
        "name": "m84dafa0a2511402b"
      }
