    {
      "id": "meecec7c96b404d96",
      "type": "text",
      "x": 1180.9630934764414,
      "y": 171.44656063792854,
      "width": 319.86016845703125,
      "height": 354.2610098874585,
      "text": "Ollama está pra LLM assim como Docker\nestá pra aplicação — baixa e roda com\num comando, sem depender de internet.\n\nInstalação:\n  ... faremos no lab\n\nUso:\n  ollama run llama3.2\n  ollama run qwen2.5:7b\n\nVantagens:\n✅ Sem API key — execução 100% local\n✅ Dados não saem da máquina\n✅ Ideal para testar e comparar modelos\n\nAnalogia: Docker pull + run, mas pra LLMs.",
      "fontSize": 16.671106347645104,
      "strokeColor": "#1e1e1e",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "opacity": 100,
      "roughness": 0,
      "roundness": null,
      "boundElements": [],
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 1,
      "versionNonce": 960905066,
      "updated": 1786128359534,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 127,
      "index": "aH",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "link": null,
      "containerId": null,
      "originalText": "Ollama está pra LLM assim como Docker\nestá pra aplicação — baixa e roda com\num comando, sem depender de internet.\n\nInstalação:\n  ... faremos no lab\n\nUso:\n  ollama run llama3.2\n  ollama run qwen2.5:7b\n\nVantagens:\n✅ Sem API key — execução 100% local\n✅ Dados não saem da máquina\n✅ Ideal para testar e comparar modelos\n\nAnalogia: Docker pull + run, mas pra LLMs.",
      "customData": {
        "name": "meecec7c96b404d96"
      }
    },
