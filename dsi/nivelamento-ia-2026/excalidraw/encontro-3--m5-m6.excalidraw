      "locked": false,
      "seed": 1,
      "versionNonce": 998460850,
      "updated": 1787778265044,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "text": "—  Todo desenvolvedor passa a ser também arquiteto\n—  O foco sai do código e vai para a arquitetura\n—  Projetar passa a ser mais importante do que implementar\n—  Agentes assumem a escrita e a alteração do código\n—  O desenvolvedor define direção, limites e critérios",
      "fontSize": 21,
      "strokeColor": "#334155",
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.5,
      "backgroundColor": "transparent",
      "version": 2,
      "index": "aS",
      "strokeWidth": 2,
      "link": null,
      "containerId": null,
      "originalText": "—  Todo desenvolvedor passa a ser também arquiteto\n—  O foco sai do código e vai para a arquitetura\n—  Projetar passa a ser mais importante do que implementar\n—  Agentes assumem a escrita e a alteração do código\n—  O desenvolvedor define direção, limites e critérios",
      "customData": {
        "name": "p2835ba339a8348e0"
      }
    },
